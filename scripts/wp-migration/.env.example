# Strapi target (required for import scripts)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-full-access-api-token

# Command 1 — preview import:
#   node scripts/wp-migration/import-preview-to-strapi.mjs <site-slug>
#
# Command 2 — full migration import:
#   node scripts/wp-migration/import-full-to-strapi.mjs <site-slug>
